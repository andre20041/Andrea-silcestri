<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HabitTracker" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent_light</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_card</item>
    </style>

    <style name="FabSquircle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="RedOutlinedBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/accent_light</item>
        <item name="hintTextColor">@color/accent_light</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>
</resources>
