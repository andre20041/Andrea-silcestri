<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="48dp"
    android:layout_height="72dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp">

    <!-- Pill background (always visible: dark or selected-red) -->
    <View
        android:id="@+id/v_pill_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_calendar_pill_dark"/>

    <!-- Day content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_day_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lun"
            android:textColor="#666666"
            android:textSize="11sp"
            android:letterSpacing="0.05"/>

        <TextView
            android:id="@+id/tv_day_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="1"
            android:textColor="#999999"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <!-- Small dot under selected day -->
        <View
            android:id="@+id/v_today_dot"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_calendar_selected"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- Hidden views kept for CalendarAdapter compatibility -->
    <View android:id="@+id/v_circle_bg" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <View android:id="@+id/v_today_ring" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

</FrameLayout>
