<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_card"
    android:paddingBottom="24dp">

    <View android:layout_width="40dp" android:layout_height="4dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="#555555"/>

    <LinearLayout android:id="@+id/item_abitudine"
        android:layout_width="match_parent" android:layout_height="72dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground">
        <FrameLayout android:layout_width="44dp" android:layout_height="44dp">
            <View android:layout_width="44dp" android:layout_height="44dp"
                android:background="#33EF5350" android:backgroundTint="#33EF5350"/>
            <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:text="🏆" android:textSize="22sp"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Abitudine" android:textColor="#FFFFFF"
                android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Attività che si ripete nel tempo. Ha un\nmonitoraggio e statistiche dettagliate."
                android:textColor="#999999" android:textSize="13sp"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="›" android:textColor="#999999" android:textSize="22sp"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#2A2A2A" android:layout_marginStart="80dp"/>

    <LinearLayout android:id="@+id/item_ricorrente"
        android:layout_width="match_parent" android:layout_height="72dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground">
        <FrameLayout android:layout_width="44dp" android:layout_height="44dp">
            <View android:layout_width="44dp" android:layout_height="44dp"
                android:background="#33EF5350"/>
            <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:text="🔄" android:textSize="22sp"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Attività ricorrente" android:textColor="#FFFFFF"
                android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Attività che si ripete nel tempo senza\ntracciamento o statistica."
                android:textColor="#999999" android:textSize="13sp"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="›" android:textColor="#999999" android:textSize="22sp"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#2A2A2A" android:layout_marginStart="80dp"/>

    <LinearLayout android:id="@+id/item_attivita"
        android:layout_width="match_parent" android:layout_height="72dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground">
        <FrameLayout android:layout_width="44dp" android:layout_height="44dp">
            <View android:layout_width="44dp" android:layout_height="44dp"
                android:background="#33EF5350"/>
            <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:text="✅" android:textSize="22sp"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Attività" android:textColor="#FFFFFF"
                android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Attività a istanza singola senza\ntracciamento nel tempo."
                android:textColor="#999999" android:textSize="13sp"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="›" android:textColor="#999999" android:textSize="22sp"/>
    </LinearLayout>
</LinearLayout>
